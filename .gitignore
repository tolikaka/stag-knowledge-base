# Секреты — никогда не в репозитории
config.py
bot_session.session
*.session

# Логи
*.log
ai_diag_uz.log
stag_bot.log

# Python кэш
__pycache__/
*.pyc
*.pyo
*.pyd

# Бинарные файлы в files_cache
files_cache/*.exe
